# Copy this file to .env and change what you need. Never commit .env.

# shadow = decide and log, but only write to a local pretend calendar (data/shadow_calendar.db)
# live   = actually create, move and delete events in your Outlook calendar
MODE=shadow

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=calbot-base

# Bridge between the Node listener and the Python brain (both sides read these)
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765

# Behaviour
TIMEZONE=Asia/Kolkata
MEMORY_DAYS=2
CONTEXT_MESSAGES=15
MIN_CONFIDENCE=0.6
DEFAULT_EVENT_MINUTES=60
LOOKAHEAD_DAYS=45
CALENDAR_TAG=CalBot

# Outlook (only needed for MODE=live). Application (client) ID from your app registration.
MS_CLIENT_ID=

# Listener catch-up after the laptop was off
BACKFILL_LIMIT=50
BACKFILL_HOURS=36

# Where databases and exports go (relative to the project folder)
DATA_DIR=data
